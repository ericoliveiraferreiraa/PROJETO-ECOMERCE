PORT=3000
DB_PATH=../database/DB-ecomerce.sqlite

# Gere uma chave nova para cada ambiente. Nunca reutilize valor compartilhado.
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
JWT_EXPIRES_IN=8h

# Preencha no arquivo .env local; não comite credenciais reais.
MP_ACCESS_TOKEN=APP_USR-seu-token-aqui
FRONTEND_URL=http://localhost:5173
MP_NOTIFICATION_URL=
